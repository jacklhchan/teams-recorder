<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TeamsRecorder.Windows.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TeamsRecorder.Windows.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1060" Padding="28,20,28,28" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Teams Recorder — 音訊錄製 MVP" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="錄製系統輸出與可選麥克風，工作階段以 M4A 為目標格式。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar IsOpen="{Binding HasError}" IsClosable="True" Severity="Error" Title="需要處理的問題" Message="{Binding ErrorText}" />

            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                <StackPanel Spacing="14">
                    <TextBlock Text="設定與就緒狀態" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding ReadinessText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="系統輸出裝置" />
                            <ComboBox DisplayMemberPath="DisplayName" IsEnabled="{Binding IsDeviceSelectionEnabled}" ItemsSource="{Binding RenderEndpoints}" SelectedItem="{Binding SelectedRenderEndpoint, Mode=TwoWay}" />
                            <TextBlock Text="{Binding SelectedRenderDescription}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="麥克風（可選）" />
                            <ComboBox DisplayMemberPath="DisplayName" IsEnabled="{Binding IsDeviceSelectionEnabled}" ItemsSource="{Binding CaptureEndpoints}" SelectedItem="{Binding SelectedMicrophoneEndpoint, Mode=TwoWay}" />
                            <TextBlock Text="{Binding SelectedMicrophoneDescription}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="5">
                        <TextBlock Text="工作階段資料庫" />
                        <TextBox IsEnabled="{Binding IsDeviceSelectionEnabled}" PlaceholderText="選擇儲存工作階段的資料夾" Text="{Binding OutputFolder, Mode=TwoWay}" />
                        <TextBlock Text="{Binding NextOutputPath}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Command="{Binding StartCommand}" Content="開始錄製" />
                        <Button Command="{Binding StopCommand}" Content="停止並儲存" />
                        <Button Command="{Binding StartTestCommand}" Content="10 秒測試" />
                        <Button Command="{Binding RefreshDevicesCommand}" Content="重新整理裝置" />
                        <ProgressRing Width="24" Height="24" IsActive="{Binding IsBusy}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="即時健康狀態" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding AggregateHealthText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RenderHealthText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MicrophoneHealthText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="經過時間" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding ElapsedText}" Style="{StaticResource TitleTextBlockStyle}" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="峰值 / 剪裁" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding PeakText}" Style="{StaticResource TitleTextBlockStyle}" /><ProgressBar Maximum="100" Value="{Binding PeakPercent}" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="儲存空間與結果" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{Binding StorageReadinessText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ResultText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <Button Command="{Binding RefreshLibraryCommand}" Content="重新掃描 M4A 工作階段" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="本機 M4A 資料庫" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="{Binding LibrarySummaryText}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                    <ListView MaxHeight="220" DisplayMemberPath="DisplayName" ItemsSource="{Binding LibraryItems}" SelectedItem="{Binding SelectedLibraryItem, Mode=TwoWay}" SelectionMode="Single" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Command="{Binding PlayCommand}" Content="播放" /><Button Command="{Binding PauseCommand}" Content="暫停" /><Button Command="{Binding StopPlaybackCommand}" Content="停止" />
                        <TextBlock Text="{Binding PlaybackText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Slider Maximum="1" Minimum="0" Value="{Binding PlaybackProgress}" IsEnabled="False" />
                </StackPanel>
            </Border>
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="此 MVP 專注音訊工作階段與本機播放；Teams API、視訊、虛擬麥克風與逐字稿將於後續版本提供。" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
