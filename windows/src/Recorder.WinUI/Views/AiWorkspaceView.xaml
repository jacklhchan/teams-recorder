<UserControl
    x:Class="TeamsRecorder.Windows.WinUI.Views.AiWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="28,22,28,14" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="AI 工作區" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="檢視所選錄音的逐字稿與 AI 工作狀態；所有傳送動作均須由您明確確認。"
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Margin="28,0,28,16"
            IsClosable="False"
            IsOpen="True"
            Message="只有您明確開始的工作才會傳送到所選 AI 供應商。轉錄會上傳所選錄音；產生摘要只會傳送已完成的逐字稿文字。"
            Severity="Informational"
            Title="您的資料與控制權" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,0,28,28" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" MinWidth="320" />
                    <ColumnDefinition Width="1.1*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="逐字稿" />
                        <TextBox
                            Grid.Row="1"
                            AutomationProperties.Name="搜尋錄音"
                            PlaceholderText="搜尋錄音名稱、標籤或逐字稿"
                            Text="{Binding LibrarySearchText, Mode=TwoWay}" />
                        <ListView
                            Grid.Row="2"
                            MinHeight="280"
                            AutomationProperties.Name="可用錄音"
                            IsItemClickEnabled="True"
                            ItemsSource="{Binding LibraryItems}"
                            SelectedItem="{Binding SelectedLibraryItem, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4" Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            Text="{Binding TagsText}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            Text="{Binding AiChipText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="3" Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding SelectedLibraryDetails}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding PlayCommand}" Content="播放" />
                                <Button Command="{Binding PauseCommand}" Content="暫停" />
                                <Button Command="{Binding StopPlaybackCommand}" Content="停止" />
                            </StackPanel>
                            <Slider
                                AutomationProperties.Name="播放進度"
                                Maximum="1"
                                Minimum="0"
                                Value="{Binding PlaybackProgress, Mode=TwoWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding PlaybackTimeReadout}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="AI 處理" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="選取已完成的受管理錄音後，您可以明確選擇建立逐字稿或為既有逐字稿產生摘要。"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="ASR 模型" />
                                    <ComboBox
                                        IsEditable="True"
                                        IsEnabled="{Binding IsOpenAiProviderAvailable}"
                                        ItemsSource="{Binding OpenAiDiscoveredModels}"
                                        Text="{Binding OpenAiAsrModel, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="摘要模型" />
                                    <ComboBox
                                        IsEditable="True"
                                        IsEnabled="{Binding IsOpenAiProviderAvailable}"
                                        ItemsSource="{Binding OpenAiDiscoveredModels}"
                                        Text="{Binding OpenAiLlmModel, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Spacing="4">
                                    <TextBlock Text="語言（選填）" />
                                    <TextBox IsEnabled="{Binding IsOpenAiProviderAvailable}" Text="{Binding OpenAiLanguage, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4">
                                    <TextBlock Text="供應商狀態" />
                                    <TextBlock Text="{Binding OpenAiProviderIntegrationStatus}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Message="AI 處理不會自動執行。按下下列按鈕後，仍需在確認視窗中同意才會傳送資料。"
                                Severity="Informational" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    AutomationProperties.Name="建立逐字稿"
                                    Click="OnStartTranscriptionClick"
                                    Content="建立逐字稿"
                                    IsEnabled="{Binding CanStartOpenAiTranscription}" />
                                <Button
                                    AutomationProperties.Name="產生摘要"
                                    Click="OnGenerateSummaryClick"
                                    Content="產生摘要"
                                    IsEnabled="{Binding CanGenerateOpenAiSummary}" />
                                <ProgressRing Height="20" IsActive="{Binding IsBusy}" Width="20" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="會議摘要" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="完成後，逐字稿與摘要會安全儲存在所選錄音工作階段中；可從錄音庫重新開啟或播放。"
                                TextWrapping="Wrap" />
                            <Border
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="尚未選取可處理的錄音。請先在左側選擇已完成的錄音，然後由您決定是否開始 AI 處理。"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
