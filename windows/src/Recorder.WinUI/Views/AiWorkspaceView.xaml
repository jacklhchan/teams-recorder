<UserControl
    x:Class="TeamsRecorder.Windows.WinUI.Views.AiWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="28,22,28,14" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="AI 工作區" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="檢視、修改及匯出逐字稿與 Meeting Intelligence；開始 AI 工作前均須由您明確確認。"
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Margin="28,0,28,16"
            IsClosable="False"
            IsOpen="True"
            Message="只有您明確開始的工作才會傳送到所選 AI 供應商。確認轉錄時，可同時授權逐字稿完成後自動產生摘要及建議標題；重新產生只會傳送逐字稿。"
            Severity="Informational"
            Title="您的資料與控制權" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,0,28,28" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" MinWidth="320" />
                    <ColumnDefinition Width="1.1*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="逐字稿" />
                        <TextBox
                            Grid.Row="1"
                            AutomationProperties.Name="搜尋錄音"
                            PlaceholderText="搜尋錄音名稱、標籤或逐字稿"
                            Text="{Binding LibrarySearchText, Mode=TwoWay}" />
                        <ListView
                            Grid.Row="2"
                            MinHeight="280"
                            AutomationProperties.Name="可用錄音"
                            IsItemClickEnabled="True"
                            ItemsSource="{Binding LibraryItems}"
                            SelectedItem="{Binding SelectedLibraryItem, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4" Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            Text="{Binding TagsText}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            Text="{Binding AiChipText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="3" Spacing="8">
                            <Button
                                AutomationProperties.AutomationId="AiImportAudioButton"
                                Click="OnImportAudioClick"
                                Content="匯入音訊以轉錄"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding CanImportAudioForTranscription}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding SelectedLibraryDetails}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding PlayCommand}" Content="播放" />
                                <Button Command="{Binding PauseCommand}" Content="暫停" />
                                <Button Command="{Binding StopPlaybackCommand}" Content="停止" />
                            </StackPanel>
                            <Slider
                                AutomationProperties.Name="播放進度"
                                Maximum="1"
                                Minimum="0"
                                Value="{Binding PlaybackProgress, Mode=TwoWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding PlaybackTimeReadout}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="AI 處理" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="選取已完成的受管理錄音後，您可以明確選擇建立逐字稿或為既有逐字稿產生摘要。"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="ASR 模型" />
                                    <ComboBox
                                        IsEditable="True"
                                        IsEnabled="{Binding IsOpenAiProviderAvailable}"
                                        ItemsSource="{Binding OpenAiDiscoveredModels}"
                                        Text="{Binding OpenAiAsrModel, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="摘要模型" />
                                    <ComboBox
                                        IsEditable="True"
                                        IsEnabled="{Binding IsOpenAiProviderAvailable}"
                                        ItemsSource="{Binding OpenAiDiscoveredModels}"
                                        Text="{Binding OpenAiLlmModel, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Spacing="4">
                                    <TextBlock Text="語言（選填）" />
                                    <TextBox IsEnabled="{Binding IsOpenAiProviderAvailable}" Text="{Binding OpenAiLanguage, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4">
                                    <TextBlock Text="供應商狀態" />
                                    <TextBlock Text="{Binding OpenAiProviderIntegrationStatus}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Message="AI 處理不會自動執行。按下下列按鈕後，仍需在確認視窗中同意才會傳送資料。"
                                Severity="Informational" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    AutomationProperties.Name="建立逐字稿"
                                    Click="OnStartTranscriptionClick"
                                    Content="建立逐字稿"
                                    IsEnabled="{Binding CanStartOpenAiTranscription}" />
                                <Button
                                    AutomationProperties.Name="產生摘要"
                                    Click="OnGenerateSummaryClick"
                                    Content="產生摘要"
                                    IsEnabled="{Binding CanGenerateOpenAiSummary}" />
                                <ProgressRing Height="20" IsActive="{Binding IsBusy}" Width="20" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="逐字稿編輯器" />
                            <TextBox
                                AcceptsReturn="True"
                                AutomationProperties.AutomationId="AiTranscriptEditor"
                                IsEnabled="{Binding CanSaveTranscript}"
                                MinHeight="220"
                                Text="{Binding TranscriptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnSaveTranscriptClick" Content="儲存逐字稿" IsEnabled="{Binding CanSaveTranscript}" />
                                <Button Click="OnCopyTranscriptClick" Content="複製" IsEnabled="{Binding CanSaveTranscript}" />
                                <Button Click="OnExportTranscriptClick" Content="匯出" IsEnabled="{Binding CanSaveTranscript}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Meeting Intelligence" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding MeetingIntelligenceStatus}" TextWrapping="Wrap" />
                            <TextBox
                                AcceptsReturn="True"
                                AutomationProperties.AutomationId="AiMeetingSummaryEditor"
                                Header="摘要"
                                IsEnabled="{Binding CanSaveMeetingIntelligence}"
                                MinHeight="150"
                                Text="{Binding MeetingIntelligenceSummary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                            <TextBox
                                AutomationProperties.AutomationId="AiSuggestedTitleEditor"
                                Header="建議標題"
                                IsEnabled="{Binding CanSaveMeetingIntelligence}"
                                Text="{Binding MeetingIntelligenceSuggestedTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnGenerateSummaryClick" Content="產生／重新產生" IsEnabled="{Binding CanGenerateOpenAiSummary}" />
                                <Button Click="OnCancelMeetingIntelligenceClick" Content="取消" IsEnabled="{Binding CanCancelMeetingIntelligence}" />
                                <Button Click="OnSaveMeetingIntelligenceClick" Content="儲存修改" IsEnabled="{Binding CanSaveMeetingIntelligence}" />
                                <Button Click="OnApplySuggestedTitleClick" Content="套用建議標題" IsEnabled="{Binding CanSaveMeetingIntelligence}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
