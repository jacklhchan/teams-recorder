<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TeamsRecorder.Windows.WinUI.RecordingOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="錄音控制器"
    mc:Ignorable="d">
    <Border
        x:Name="OverlayRoot"
        Padding="14,12"
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="16">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="HeaderDragSurface"
                Background="Transparent"
                ColumnSpacing="10"
                AutomationProperties.AutomationId="RecordingOverlayDragSurface"
                AutomationProperties.Name="拖曳以移動錄音控制器"
                PointerPressed="OnHeaderPointerPressed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Width="28"
                    FontSize="15"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE700;"
                    ToolTipService.ToolTip="按住頂部以拖曳浮動視窗" />
                <Ellipse Grid.Column="1" x:Name="RecordingIndicator" Width="10" Height="10" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                <StackPanel Grid.Column="2" Spacing="1">
                    <TextBlock x:Name="StatusText" FontSize="16" FontWeight="SemiBold" Text="自動錄音即將開始" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StatusDetailText" AutomationProperties.AutomationId="StatusDetailText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="錄音控制器不會取得 Teams 焦點" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="ElapsedText" AutomationProperties.AutomationId="ElapsedText" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Visibility="Collapsed" />
                    <Button
                        x:Name="CompactButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="RecordingOverlayCompactButton"
                        AutomationProperties.Name="最小化錄音控制器"
                        Click="OnCompactButtonClick"
                        Content="—"
                        ToolTipService.ToolTip="最小化" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button
                        x:Name="ActionButton"
                        MinWidth="96"
                        AutomationProperties.AutomationId="RecordingOverlayLifecycleActionButton"
                        Click="OnActionButtonClick"
                        Content="取消" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" x:Name="CountdownCard" Padding="10,7" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <TextBlock x:Name="CountdownText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="倒數 0 秒" />
            </Border>

            <StackPanel Grid.Row="2" x:Name="SourcesPanel" Spacing="6" Visibility="Collapsed">
                <Border Padding="10,7" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE767;" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                        <TextBlock Grid.Column="1" Text="Teams／系統輸出" VerticalAlignment="Center" FontSize="12" />
                        <ProgressBar x:Name="SystemWaveform" Grid.Column="2" Height="6" VerticalAlignment="Center" Value="0" Maximum="100" AutomationProperties.AutomationId="SystemWaveform" AutomationProperties.Name="Teams／系統輸出即時音量" />
                        <TextBlock x:Name="SystemAudioStatusText" Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>
                <Border Padding="10,7" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon x:Name="MicrophoneIcon" Glyph="&#xE720;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="麥克風" FontSize="12" /><TextBlock x:Name="MicrophoneScopeText" Text="狀態顯示；不會控制 Teams" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                        <ProgressBar x:Name="MicrophoneWaveform" Grid.Column="2" Height="6" VerticalAlignment="Center" Value="0" Maximum="100" AutomationProperties.AutomationId="MicrophoneWaveform" AutomationProperties.Name="麥克風即時輸入音量" />
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Row="3" x:Name="ScreenCaptureCard" Padding="10,7" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Visibility="Collapsed">
                <Grid ColumnSpacing="8" RowSpacing="7">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7F4;" Foreground="{ThemeResource SystemFillColorAttentionBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="錄製 Teams 畫面" FontSize="12" /><TextBlock x:Name="TeamsWindowCaptureStatusText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="自動尋找目前會議視窗" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <ToggleSwitch x:Name="TeamsWindowCaptureToggle" Grid.Column="2" AutomationProperties.AutomationId="TeamsWindowCaptureToggle" OffContent="關" OnContent="開" Toggled="OnTeamsWindowCaptureToggleToggled" />
                    <ComboBox
                        x:Name="TeamsWindowCaptureTargetSelector"
                        Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="250"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="TeamsWindowCaptureTargetSelector"
                        AutomationProperties.Name="選擇 Teams 會議視窗"
                        DisplayMemberPath="DisplayName"
                        PlaceholderText="找不到可驗證的 Teams 視窗"
                        SelectionChanged="OnTeamsWindowCaptureTargetSelectionChanged" />
                    <Button
                        x:Name="TeamsWindowCaptureRefreshButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        Width="34"
                        Height="34"
                        Padding="0"
                        AutomationProperties.AutomationId="TeamsWindowCaptureRefreshButton"
                        AutomationProperties.Name="重新整理 Teams 視窗"
                        Click="OnTeamsWindowCaptureRefreshClick"
                        ToolTipService.ToolTip="重新整理 Teams 視窗">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
