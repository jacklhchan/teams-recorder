<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>TeamsRecorder.Windows.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Default to a directly runnable developer build. Set WindowsPackageType=MSIX
         only when producing a signed installer. -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(WindowsPackageType)' == 'None'">true</WindowsAppSDKSelfContained>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-x64.pubxml')">win-x64</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Recorder.Application\Recorder.Application.csproj" />
    <!-- Built as a self-contained single executable below.  The project
         reference makes standalone restore/build include its assets without
         loading the helper assembly into the WinUI process. -->
    <ProjectReference Include="..\Recorder.AsrWorker\Recorder.AsrWorker.csproj"
                      ReferenceOutputAssembly="false"
                      AdditionalProperties="RuntimeIdentifier=win-x64;SelfContained=true" />

    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <PropertyGroup>
    <NativeBridgePath>$(MSBuildThisFileDirectory)..\..\out\native\$(Configuration)\Recorder.NativeBridge.dll</NativeBridgePath>
    <AsrWorkerProjectPath>$(MSBuildThisFileDirectory)..\Recorder.AsrWorker\Recorder.AsrWorker.csproj</AsrWorkerProjectPath>
    <!-- Must be absolute because this value is passed into the worker project
         through MSBuild, whose project directory is different from WinUI's. -->
    <AsrWorkerPublishDirectory>$(MSBuildProjectDirectory)\obj\asr-worker\$(Configuration)\</AsrWorkerPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(NativeBridgePath)"
             Link="Recorder.NativeBridge.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.5.0" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- WinUI and Windows Runtime projections use activation metadata that must not be trimmed. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <Target Name="RequireNativeBridge" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(NativeBridgePath)')"
           Text="Recorder.NativeBridge.dll is missing for $(Configuration). Build windows/native with the matching x64 preset before building Recorder.WinUI." />
  </Target>

  <!-- Media Foundation's synchronous source-reader calls are intentionally
       hosted out-of-process. Package a self-contained, single-file helper
       next to the WinUI executable so deployed builds never fall back to an
       in-process decoder or depend on a machine-wide .NET runtime. -->
  <Target Name="PublishAsrWorker"
          BeforeTargets="CopyFilesToOutputDirectory;CopyFilesToPublishDirectory"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(AsrWorkerProjectPath)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;PublishTrimmed=false;PublishReadyToRun=false;PublishDir=$(AsrWorkerPublishDirectory);RestoreIgnoreFailedSources=true" />
    <Error Condition="!Exists('$(AsrWorkerPublishDirectory)Recorder.AsrWorker.exe')"
           Text="Recorder.AsrWorker.exe was not produced for the WinUI deployment." />
  </Target>

  <Target Name="CopyAsrWorkerToOutput"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="PublishAsrWorker"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="$(AsrWorkerPublishDirectory)Recorder.AsrWorker.exe"
          DestinationFiles="$(OutDir)Recorder.AsrWorker.exe"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyAsrWorkerToPublish"
          AfterTargets="CopyFilesToPublishDirectory"
          DependsOnTargets="PublishAsrWorker"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="$(AsrWorkerPublishDirectory)Recorder.AsrWorker.exe"
          DestinationFiles="$(PublishDir)Recorder.AsrWorker.exe"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- MSIX gathers PackagingOutputs before the ordinary output copy target.
       A project-reference apphost can therefore win the same-name payload
       de-duplication and leave its deps/runtimeconfig sidecars behind. Replace
       those payload entries after MSIX computes them, before it writes the
       recipe, with the verified self-contained publish artifact. -->
  <Target Name="UseSelfContainedAsrWorkerInMsixPayload"
          AfterTargets="_ComputeAppxPackagePayload"
          BeforeTargets="_GenerateAppxPackageRecipe"
          DependsOnTargets="PublishAsrWorker"
          Condition="'$(AppxPackage)' == 'true' and '$(WindowsPackageType)' == 'MSIX' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <AppxPackagePayload Remove="@(AppxPackagePayload)"
                          Condition="'%(TargetPath)' == 'Recorder.AsrWorker.exe' or '%(TargetPath)' == 'Recorder.AsrWorker.deps.json' or '%(TargetPath)' == 'Recorder.AsrWorker.runtimeconfig.json'" />
      <AppxPackagePayload Include="$(AsrWorkerPublishDirectory)Recorder.AsrWorker.exe">
        <TargetPath>Recorder.AsrWorker.exe</TargetPath>
      </AppxPackagePayload>
    </ItemGroup>
    <Error Condition="!Exists('$(AsrWorkerPublishDirectory)Recorder.AsrWorker.exe')"
           Text="The MSIX package cannot include the missing self-contained Recorder.AsrWorker.exe." />
  </Target>
</Project>
