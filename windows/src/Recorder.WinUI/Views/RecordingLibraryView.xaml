<UserControl
    x:Class="TeamsRecorder.Windows.WinUI.Views.RecordingLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TeamsRecorder.Windows.WinUI.Views"
    xmlns:media="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailPanel.(Grid.Row)" Value="1" />
                        <Setter Target="DetailPanel.(Grid.Column)" Value="0" />
                        <Setter Target="DetailsHeader.Orientation" Value="Vertical" />
                        <Setter Target="MetadataPanel.Orientation" Value="Vertical" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailPanel.(Grid.Row)" Value="0" />
                        <Setter Target="DetailPanel.(Grid.Column)" Value="1" />
                        <Setter Target="DetailsHeader.Orientation" Value="Horizontal" />
                        <Setter Target="MetadataPanel.Orientation" Value="Horizontal" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="24,20,24,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="錄音庫" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding LibrarySummaryText}" />
                <TextBlock
                    AutomationProperties.AutomationId="LibraryLoadingText"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="{Binding LibraryLoadingText}" />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" ClosedDisplayMode="Compact" DefaultLabelPosition="Collapsed">
                <AppBarButton AutomationProperties.Name="重新整理錄音庫" Command="{Binding RefreshLibraryCommand}" Icon="Refresh" Label="重新整理" />
                <AppBarButton AutomationProperties.Name="開啟所選錄音的資料夾" Command="{Binding OpenLibraryFolderCommand}" Icon="Folder" Label="開啟資料夾" />
            </CommandBar>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,0,24,28" RowSpacing="16" ColumnSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="LibraryPanel"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox
                            x:Name="LibrarySearchBox"
                            AutomationProperties.Name="搜尋錄音庫"
                            PlaceholderText="搜尋標題、標籤或逐字稿"
                            Text="{Binding LibrarySearchText, Mode=TwoWay}"
                            TextChanged="OnLibrarySearchTextChanged" />
                        <ToggleSwitch
                            Grid.Row="1"
                            AutomationProperties.Name="只顯示最愛錄音"
                            Header="只顯示最愛"
                            IsOn="{Binding LibraryFavoritesOnly, Mode=TwoWay}" />
                        <ListView
                            Grid.Row="2"
                            MinHeight="360"
                            AutomationProperties.Name="錄音清單"
                            ItemsSource="{Binding LibraryItems}"
                            SelectedItem="{Binding SelectedLibraryItem, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,10" RowSpacing="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding KindText}" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                            <Border Padding="7,2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="9">
                                                <TextBlock Text="{Binding MediaKindText}" />
                                            </Border>
                                            <Border Padding="7,2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="9">
                                                <TextBlock Text="{Binding SourceText}" />
                                            </Border>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding AvailabilityText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Spacing="2">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding TagsText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontStyle="Italic" MaxLines="2" Text="{Binding TranscriptSnippet}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    x:Name="DetailPanel"
                    Grid.Row="1"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="16">
                        <StackPanel x:Name="DetailsHeader" Spacing="8">
                            <StackPanel Spacing="3">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding SelectedLibraryItem.DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SelectedLibraryDetails}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Padding="7,2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="9"><TextBlock Text="{Binding PlaybackMediaKindText}" /></Border>
                                <Border Padding="7,2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="9"><TextBlock Text="{Binding PlaybackAiChipText}" /></Border>
                            </StackPanel>
                        </StackPanel>

                        <Grid Height="280" MinHeight="200">
                            <media:MediaPlayerElement
                                x:Name="PlaybackVideoStage"
                                AreTransportControlsEnabled="False"
                                AutoPlay="False"
                                AutomationProperties.Name="影片播放畫面"
                                Stretch="Uniform"
                                Visibility="{Binding IsVideoPlaybackStageVisible}" />
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Visibility="{Binding IsAudioPlaybackStageVisible}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="48" Glyph="&#xE189;" HorizontalAlignment="Center" />
                                    <TextBlock Text="純音訊錄音" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding PlaybackText}" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PlaybackElapsedText}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" IsEnabled="{Binding CanSeek}" Maximum="{Binding PlaybackDurationSeconds}" Minimum="0" Value="{Binding PlaybackPositionSeconds, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding PlaybackRemainingText}" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding SkipBackward15Command}" Content="−15 秒" />
                                <Button AutomationProperties.AutomationId="PlaybackPlayButton" AutomationProperties.Name="播放" Command="{Binding PlayCommand}" Style="{StaticResource AccentButtonStyle}"><SymbolIcon Symbol="Play" /></Button>
                                <Button AutomationProperties.AutomationId="PlaybackPauseButton" AutomationProperties.Name="暫停" Command="{Binding PauseCommand}"><SymbolIcon Symbol="Pause" /></Button>
                                <Button AutomationProperties.AutomationId="PlaybackStopButton" AutomationProperties.Name="停止播放" Command="{Binding StopPlaybackCommand}"><SymbolIcon Symbol="Stop" /></Button>
                                <Button Command="{Binding SkipForward15Command}" Content="+15 秒" />
                            </StackPanel>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding PlaybackText}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="音量" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Maximum="1" Minimum="0" Value="{Binding PlaybackVolume, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="速度" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="3" DisplayMemberPath="DisplayName" ItemsSource="{Binding PlaybackRateChoices}" SelectedValue="{Binding SelectedPlaybackRate, Mode=TwoWay}" SelectedValuePath="Rate" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <StackPanel x:Name="MetadataPanel" Spacing="12">
                            <TextBox Header="名稱" IsEnabled="{Binding CanManageLibrary}" PlaceholderText="為這個工作階段命名" Text="{Binding LibraryTitle, Mode=TwoWay}" />
                            <TextBox Header="標籤" IsEnabled="{Binding CanManageLibrary}" PlaceholderText="以逗號分隔" Text="{Binding LibraryTagsText, Mode=TwoWay}" />
                            <ToggleSwitch Header="最愛" IsEnabled="{Binding CanManageLibrary}" IsOn="{Binding IsLibraryFavorite, Mode=TwoWay}" />
                        </StackPanel>
                        <CommandBar Background="Transparent" ClosedDisplayMode="Compact" DefaultLabelPosition="Right">
                            <AppBarButton Command="{Binding SaveLibraryMetadataCommand}" Icon="Save" Label="儲存資料" />
                            <AppBarButton Command="{Binding OpenLibraryFolderCommand}" Icon="OpenFile" Label="開啟資料夾" />
                            <AppBarButton Command="{Binding RequestRecycleLibraryCommand}" Icon="Delete" Label="移至資源回收桶" />
                            <AppBarButton Command="{Binding ConfirmRecycleLibraryCommand}" Icon="Accept" Label="確認移除" />
                            <AppBarButton Command="{Binding CancelRecycleLibraryCommand}" Icon="Cancel" Label="取消" />
                        </CommandBar>
                        <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{Binding RecycleConfirmationText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
