<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared Fluent design tokens. Consume theme-aware brushes with
        {ThemeResource Recorder...Brush}; spacing, type and shape values are
        theme-independent and can use {StaticResource ...}.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="RecorderAppBackgroundColor">#FFF7F8FA</Color>
            <Color x:Key="RecorderSurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="RecorderSurfaceSubtleColor">#FFF1F3F6</Color>
            <Color x:Key="RecorderCardStrokeColor">#14000000</Color>
            <Color x:Key="RecorderTextPrimaryColor">#FF1A1C1E</Color>
            <Color x:Key="RecorderTextSecondaryColor">#FF5F6368</Color>
            <Color x:Key="RecorderNavSelectedColor">#FFE7F0FF</Color>
            <Color x:Key="RecorderNavSelectedTextColor">#FF005FB8</Color>
            <Color x:Key="RecorderPrimaryColor">#FF0F6CBD</Color>
            <Color x:Key="RecorderPrimaryHoverColor">#FF005A9E</Color>
            <Color x:Key="RecorderPrimaryPressedColor">#FF004578</Color>
            <Color x:Key="RecorderDangerColor">#FFC42B1C</Color>
            <Color x:Key="RecorderDangerSubtleColor">#FFFDE7E5</Color>
            <Color x:Key="RecorderSuccessColor">#FF107C10</Color>
            <Color x:Key="RecorderWarningColor">#FF9D5D00</Color>
            <Color x:Key="RecorderInfoColor">#FF0F6CBD</Color>

            <SolidColorBrush x:Key="RecorderAppBackgroundBrush" Color="{StaticResource RecorderAppBackgroundColor}" />
            <SolidColorBrush x:Key="RecorderSurfaceBrush" Color="{StaticResource RecorderSurfaceColor}" />
            <SolidColorBrush x:Key="RecorderSurfaceSubtleBrush" Color="{StaticResource RecorderSurfaceSubtleColor}" />
            <SolidColorBrush x:Key="RecorderCardStrokeBrush" Color="{StaticResource RecorderCardStrokeColor}" />
            <SolidColorBrush x:Key="RecorderTextPrimaryBrush" Color="{StaticResource RecorderTextPrimaryColor}" />
            <SolidColorBrush x:Key="RecorderTextSecondaryBrush" Color="{StaticResource RecorderTextSecondaryColor}" />
            <SolidColorBrush x:Key="RecorderNavSelectedBrush" Color="{StaticResource RecorderNavSelectedColor}" />
            <SolidColorBrush x:Key="RecorderNavSelectedTextBrush" Color="{StaticResource RecorderNavSelectedTextColor}" />
            <SolidColorBrush x:Key="RecorderPrimaryBrush" Color="{StaticResource RecorderPrimaryColor}" />
            <SolidColorBrush x:Key="RecorderPrimaryHoverBrush" Color="{StaticResource RecorderPrimaryHoverColor}" />
            <SolidColorBrush x:Key="RecorderPrimaryPressedBrush" Color="{StaticResource RecorderPrimaryPressedColor}" />
            <SolidColorBrush x:Key="RecorderDangerBrush" Color="{StaticResource RecorderDangerColor}" />
            <SolidColorBrush x:Key="RecorderDangerSubtleBrush" Color="{StaticResource RecorderDangerSubtleColor}" />
            <SolidColorBrush x:Key="RecorderSuccessBrush" Color="{StaticResource RecorderSuccessColor}" />
            <SolidColorBrush x:Key="RecorderWarningBrush" Color="{StaticResource RecorderWarningColor}" />
            <SolidColorBrush x:Key="RecorderInfoBrush" Color="{StaticResource RecorderInfoColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="RecorderAppBackgroundColor">#FF1B1B1F</Color>
            <Color x:Key="RecorderSurfaceColor">#FF242428</Color>
            <Color x:Key="RecorderSurfaceSubtleColor">#FF2D2D32</Color>
            <Color x:Key="RecorderCardStrokeColor">#24FFFFFF</Color>
            <Color x:Key="RecorderTextPrimaryColor">#FFF4F4F4</Color>
            <Color x:Key="RecorderTextSecondaryColor">#FFC3C6CA</Color>
            <Color x:Key="RecorderNavSelectedColor">#FF1B3A57</Color>
            <Color x:Key="RecorderNavSelectedTextColor">#FF9DCEFF</Color>
            <Color x:Key="RecorderPrimaryColor">#FF5EA7E8</Color>
            <Color x:Key="RecorderPrimaryHoverColor">#FF82B9ED</Color>
            <Color x:Key="RecorderPrimaryPressedColor">#FF3A8DCE</Color>
            <Color x:Key="RecorderDangerColor">#FFFF99A4</Color>
            <Color x:Key="RecorderDangerSubtleColor">#FF4D1C22</Color>
            <Color x:Key="RecorderSuccessColor">#FF6CCB5F</Color>
            <Color x:Key="RecorderWarningColor">#FFFFC86B</Color>
            <Color x:Key="RecorderInfoColor">#FF9DCEFF</Color>

            <SolidColorBrush x:Key="RecorderAppBackgroundBrush" Color="{StaticResource RecorderAppBackgroundColor}" />
            <SolidColorBrush x:Key="RecorderSurfaceBrush" Color="{StaticResource RecorderSurfaceColor}" />
            <SolidColorBrush x:Key="RecorderSurfaceSubtleBrush" Color="{StaticResource RecorderSurfaceSubtleColor}" />
            <SolidColorBrush x:Key="RecorderCardStrokeBrush" Color="{StaticResource RecorderCardStrokeColor}" />
            <SolidColorBrush x:Key="RecorderTextPrimaryBrush" Color="{StaticResource RecorderTextPrimaryColor}" />
            <SolidColorBrush x:Key="RecorderTextSecondaryBrush" Color="{StaticResource RecorderTextSecondaryColor}" />
            <SolidColorBrush x:Key="RecorderNavSelectedBrush" Color="{StaticResource RecorderNavSelectedColor}" />
            <SolidColorBrush x:Key="RecorderNavSelectedTextBrush" Color="{StaticResource RecorderNavSelectedTextColor}" />
            <SolidColorBrush x:Key="RecorderPrimaryBrush" Color="{StaticResource RecorderPrimaryColor}" />
            <SolidColorBrush x:Key="RecorderPrimaryHoverBrush" Color="{StaticResource RecorderPrimaryHoverColor}" />
            <SolidColorBrush x:Key="RecorderPrimaryPressedBrush" Color="{StaticResource RecorderPrimaryPressedColor}" />
            <SolidColorBrush x:Key="RecorderDangerBrush" Color="{StaticResource RecorderDangerColor}" />
            <SolidColorBrush x:Key="RecorderDangerSubtleBrush" Color="{StaticResource RecorderDangerSubtleColor}" />
            <SolidColorBrush x:Key="RecorderSuccessBrush" Color="{StaticResource RecorderSuccessColor}" />
            <SolidColorBrush x:Key="RecorderWarningBrush" Color="{StaticResource RecorderWarningColor}" />
            <SolidColorBrush x:Key="RecorderInfoBrush" Color="{StaticResource RecorderInfoColor}" />
        </ResourceDictionary>

        <!-- Theme lookup uses this safe fallback if the app theme is unspecified. -->
        <ResourceDictionary x:Key="Default">
            <Color x:Key="RecorderAppBackgroundColor">#FFF7F8FA</Color>
            <Color x:Key="RecorderSurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="RecorderSurfaceSubtleColor">#FFF1F3F6</Color>
            <Color x:Key="RecorderCardStrokeColor">#14000000</Color>
            <Color x:Key="RecorderTextPrimaryColor">#FF1A1C1E</Color>
            <Color x:Key="RecorderTextSecondaryColor">#FF5F6368</Color>
            <Color x:Key="RecorderNavSelectedColor">#FFE7F0FF</Color>
            <Color x:Key="RecorderNavSelectedTextColor">#FF005FB8</Color>
            <Color x:Key="RecorderPrimaryColor">#FF0F6CBD</Color>
            <Color x:Key="RecorderPrimaryHoverColor">#FF005A9E</Color>
            <Color x:Key="RecorderPrimaryPressedColor">#FF004578</Color>
            <Color x:Key="RecorderDangerColor">#FFC42B1C</Color>
            <Color x:Key="RecorderDangerSubtleColor">#FFFDE7E5</Color>
            <Color x:Key="RecorderSuccessColor">#FF107C10</Color>
            <Color x:Key="RecorderWarningColor">#FF9D5D00</Color>
            <Color x:Key="RecorderInfoColor">#FF0F6CBD</Color>

            <SolidColorBrush x:Key="RecorderAppBackgroundBrush" Color="{StaticResource RecorderAppBackgroundColor}" />
            <SolidColorBrush x:Key="RecorderSurfaceBrush" Color="{StaticResource RecorderSurfaceColor}" />
            <SolidColorBrush x:Key="RecorderSurfaceSubtleBrush" Color="{StaticResource RecorderSurfaceSubtleColor}" />
            <SolidColorBrush x:Key="RecorderCardStrokeBrush" Color="{StaticResource RecorderCardStrokeColor}" />
            <SolidColorBrush x:Key="RecorderTextPrimaryBrush" Color="{StaticResource RecorderTextPrimaryColor}" />
            <SolidColorBrush x:Key="RecorderTextSecondaryBrush" Color="{StaticResource RecorderTextSecondaryColor}" />
            <SolidColorBrush x:Key="RecorderNavSelectedBrush" Color="{StaticResource RecorderNavSelectedColor}" />
            <SolidColorBrush x:Key="RecorderNavSelectedTextBrush" Color="{StaticResource RecorderNavSelectedTextColor}" />
            <SolidColorBrush x:Key="RecorderPrimaryBrush" Color="{StaticResource RecorderPrimaryColor}" />
            <SolidColorBrush x:Key="RecorderPrimaryHoverBrush" Color="{StaticResource RecorderPrimaryHoverColor}" />
            <SolidColorBrush x:Key="RecorderPrimaryPressedBrush" Color="{StaticResource RecorderPrimaryPressedColor}" />
            <SolidColorBrush x:Key="RecorderDangerBrush" Color="{StaticResource RecorderDangerColor}" />
            <SolidColorBrush x:Key="RecorderDangerSubtleBrush" Color="{StaticResource RecorderDangerSubtleColor}" />
            <SolidColorBrush x:Key="RecorderSuccessBrush" Color="{StaticResource RecorderSuccessColor}" />
            <SolidColorBrush x:Key="RecorderWarningBrush" Color="{StaticResource RecorderWarningColor}" />
            <SolidColorBrush x:Key="RecorderInfoBrush" Color="{StaticResource RecorderInfoColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="RecorderFontFamily">Segoe UI Variable</FontFamily>
    <x:Double x:Key="RecorderFontSizeCaption">12</x:Double>
    <x:Double x:Key="RecorderFontSizeBody">14</x:Double>
    <x:Double x:Key="RecorderFontSizeSubtitle">20</x:Double>
    <x:Double x:Key="RecorderFontSizeTitle">28</x:Double>

    <CornerRadius x:Key="RecorderCornerRadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RecorderCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="RecorderCornerRadiusLarge">16</CornerRadius>

    <x:Double x:Key="RecorderSpace2">2</x:Double>
    <x:Double x:Key="RecorderSpace4">4</x:Double>
    <x:Double x:Key="RecorderSpace8">8</x:Double>
    <x:Double x:Key="RecorderSpace12">12</x:Double>
    <x:Double x:Key="RecorderSpace16">16</x:Double>
    <x:Double x:Key="RecorderSpace20">20</x:Double>
    <x:Double x:Key="RecorderSpace24">24</x:Double>
    <x:Double x:Key="RecorderSpace32">32</x:Double>
    <Thickness x:Key="RecorderCardPadding">20</Thickness>
    <Thickness x:Key="RecorderPagePadding">32</Thickness>
</ResourceDictionary>
