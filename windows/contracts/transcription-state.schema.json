{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teams-recorder.local/contracts/transcription-state.schema.json",
  "title": "Teams Recorder transcription state",
  "type": "object",
  "required": [
    "phase",
    "message",
    "startedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "queued",
        "uploading",
        "transcribing",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "message": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
