<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TeamsRecorder.Windows.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TeamsRecorder.Windows.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <NavigationView
        x:Name="WorkspaceNavigation"
        x:Uid="WorkspaceNavigation"
        AutomationProperties.AutomationId="WorkspaceNavigation"
        CompactModeThresholdWidth="640"
        ExpandedModeThresholdWidth="1000"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="220"
        PaneDisplayMode="Auto"
        SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="RecordNavigationItem"
                x:Uid="NavigationRecord"
                AutomationProperties.AutomationId="NavigationRecord"
                Tag="Record">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE720;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="RecordingsNavigationItem"
                x:Uid="NavigationRecordings"
                AutomationProperties.AutomationId="NavigationRecordings"
                Tag="Recordings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8F1;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="SettingsNavigationItem"
                x:Uid="NavigationSettings"
                AutomationProperties.AutomationId="NavigationSettings"
                Tag="Settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar
                x:Name="GlobalErrorInfoBar"
                Grid.Row="0"
                Margin="20,12,20,0"
                AutomationProperties.AutomationId="GlobalErrorInfoBar"
                IsClosable="True"
                IsOpen="{Binding HasError}"
                Message="{Binding ErrorText}"
                Severity="Error"
                Title="需要處理的問題">
                <InfoBar.ActionButton>
                    <Button
                        AutomationProperties.AutomationId="SaveDiagnosticsFromErrorButton"
                        Command="{Binding SaveDiagnosticsCommand}"
                        Content="儲存診斷報告"
                        ToolTipService.ToolTip="將已遮罩的錯誤與裝置診斷資料儲存為檔案，方便提供給支援人員。" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid Grid.Row="1">
                <!-- Record is the default workspace. It keeps the complete live state and
                     the primary actions above the fold at the 860 x 680 minimum size. -->
                <Grid
                    x:Name="RecordWorkspace"
                    AutomationProperties.AutomationId="RecordWorkspace">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="20,16,20,12" Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="RecordTitle" Style="{StaticResource TitleTextBlockStyle}" Text="錄音" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding ReadinessText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <CommandBar
                                Grid.Column="1"
                                Background="Transparent"
                                ClosedDisplayMode="Compact"
                                DefaultLabelPosition="Collapsed"
                                IsDynamicOverflowEnabled="True">
                                <AppBarButton
                                    x:Uid="RefreshDevicesButton"
                                    AutomationProperties.AutomationId="RefreshDevicesButton"
                                    Command="{Binding RefreshDevicesCommand}"
                                    Icon="Refresh"
                                    Label="重新整理裝置" />
                                <AppBarButton
                                    x:Uid="ToggleMuteButton"
                                    AutomationProperties.AutomationId="ToggleMicrophoneMuteButton"
                                    Command="{Binding ToggleLocalMicrophoneMuteCommand}"
                                    Icon="Mute"
                                    Label="切換麥克風靜音" />
                                <AppBarButton
                                    x:Uid="TestRecordingButton"
                                    AutomationProperties.AutomationId="TestRecordingToolbarButton"
                                    Command="{Binding StartTestCommand}"
                                    Icon="Play"
                                    Label="10 秒測試" />
                            </CommandBar>
                        </Grid>

                        <Border
                            Padding="16,14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            AutomationProperties.AutomationId="RecordingStatusText"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{Binding StatusText}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="經過時間" VerticalAlignment="Center" />
                                            <TextBlock
                                                AutomationProperties.AutomationId="ElapsedText"
                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                Text="{Binding ElapsedText}" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding PeakText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button
                                            x:Uid="StartRecordingButton"
                                            AutomationProperties.AutomationId="StartRecordingButton"
                                            Command="{Binding StartCommand}"
                                            Content="開始錄製"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            x:Uid="StopRecordingButton"
                                            AutomationProperties.AutomationId="StopRecordingButton"
                                            Command="{Binding StopCommand}"
                                            Content="停止並儲存" />
                                        <ProgressRing Height="22" IsActive="{Binding IsBusy}" Width="22" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontSize="18"
                                            Foreground="{Binding PrimaryHealthBrush}"
                                            Glyph="{Binding PrimaryHealthGlyph}"
                                            VerticalAlignment="Center" />
                                        <StackPanel Spacing="0">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding PrimaryHealthTitle}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                Text="{Binding PrimaryHealthDetail}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontSize="18"
                                            Foreground="{Binding MicrophoneHealthBrush}"
                                            Glyph="{Binding MicrophoneHealthGlyph}"
                                            VerticalAlignment="Center" />
                                        <StackPanel Spacing="0">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding MicrophoneHealthTitle}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                Text="{Binding MicrophoneHealthDetail}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="系統／應用程式" />
                                            <TextBlock AutomationProperties.AutomationId="OutputLevelText" Text="{Binding OutputLevelText}" />
                                        </StackPanel>
                                        <Border
                                            Height="48"
                                            Padding="6"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="6">
                                            <ItemsControl
                                                AutomationProperties.AutomationId="OutputWaveform"
                                                ItemsSource="{Binding OutputWaveformBars}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:WaveformBar">
                                                        <Border
                                                            Width="3"
                                                            Height="{Binding Height}"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            CornerRadius="2"
                                                            Opacity="{Binding Opacity}"
                                                            VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="麥克風" />
                                            <TextBlock AutomationProperties.AutomationId="InputLevelText" Text="{Binding InputLevelText}" />
                                        </StackPanel>
                                        <Border
                                            Height="48"
                                            Padding="6"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="6">
                                            <ItemsControl
                                                AutomationProperties.AutomationId="InputWaveform"
                                                ItemsSource="{Binding InputWaveformBars}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:WaveformBar">
                                                        <Border
                                                            Width="3"
                                                            Height="{Binding Height}"
                                                            Background="{ThemeResource SystemFillColorCautionBrush}"
                                                            CornerRadius="2"
                                                            Opacity="{Binding Opacity}"
                                                            VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Text="{Binding AudioHealthSummaryText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="1"
                        AutomationProperties.AutomationId="RecordConfigurationScrollViewer"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="1060" Padding="20,0,20,28" Spacing="16">
                            <Border
                                x:Name="RecordingSetupSection"
                                Padding="20"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="14">
                                    <TextBlock x:Uid="CaptureSettingsTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="擷取設定" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="音訊裝置" VerticalAlignment="Center" />
                                        <Button
                                            AutomationProperties.AutomationId="RefreshAudioDevicesButton"
                                            Command="{Binding RefreshDevicesCommand}"
                                            Content="重新整理麥克風及輸出"
                                            ToolTipService.ToolTip="重新列出 Windows 麥克風和輸出裝置。保留已選裝置；若中斷，絕不會悄悄改用預設裝置。" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="16" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="5" Visibility="{Binding RenderEndpointSelectionVisibility}">
                                            <TextBlock Text="系統輸出裝置" />
                                            <ComboBox
                                                AutomationProperties.AutomationId="RenderEndpointPicker"
                                                DisplayMemberPath="DisplayName"
                                                IsEnabled="{Binding IsDeviceSelectionEnabled}"
                                                ItemsSource="{Binding RenderEndpoints}"
                                                SelectedItem="{Binding SelectedRenderEndpoint, Mode=TwoWay}" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SelectedRenderDescription}" TextWrapping="Wrap" />
                                            <InfoBar
                                                IsClosable="False"
                                                IsOpen="{Binding HasTeamsPlaybackEndpointWarning}"
                                                Message="{Binding TeamsPlaybackEndpointWarning}"
                                                Severity="Warning"
                                                Title="確認 Teams 播放裝置" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="麥克風（可選）" />
                                            <ComboBox
                                                AutomationProperties.AutomationId="MicrophoneEndpointPicker"
                                                DisplayMemberPath="DisplayName"
                                                IsEnabled="{Binding IsDeviceSelectionEnabled}"
                                                ItemsSource="{Binding CaptureEndpoints}"
                                                SelectedItem="{Binding SelectedMicrophoneEndpoint, Mode=TwoWay}" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SelectedMicrophoneDescription}" TextWrapping="Wrap" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding RecordingMicrophoneMuteText}" TextWrapping="Wrap" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding GlobalMuteHotKeyStatus}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="錄製來源" />
                                        <ComboBox
                                            AutomationProperties.AutomationId="CaptureSourcePicker"
                                            DisplayMemberPath="DisplayName"
                                            IsEnabled="{Binding IsDeviceSelectionEnabled}"
                                            ItemsSource="{Binding CaptureSources}"
                                            SelectedItem="{Binding SelectedCaptureSource, Mode=TwoWay}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SelectedCaptureSourceDescription}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <CheckBox
                                            AutomationProperties.AutomationId="SharedContentCaptureCheckBox"
                                            Content="Capture selected Teams shared-content window (MP4)"
                                            IsChecked="{Binding IsSharedContentCaptureEnabled, Mode=TwoWay}"
                                            IsEnabled="{Binding IsDeviceSelectionEnabled}" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="Teams window" VerticalAlignment="Center" />
                                            <Button
                                                AutomationProperties.AutomationId="RefreshTeamsWindowsButton"
                                                Command="{Binding RefreshTeamsWindowsCommand}"
                                                Content="Refresh windows" />
                                        </StackPanel>
                                        <ComboBox
                                            AutomationProperties.AutomationId="TeamsCaptureWindowPicker"
                                            DisplayMemberPath="DisplayName"
                                            IsEnabled="{Binding IsDeviceSelectionEnabled}"
                                            ItemsSource="{Binding TeamsCaptureWindows}"
                                            SelectedItem="{Binding SelectedVideoCaptureWindow, Mode=TwoWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Only the selected top-level Teams window is captured. Desktop and monitor capture are never used."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Spacing="6" Visibility="{Binding SelectedApplicationPanelVisibility}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="應用程式音訊來源" VerticalAlignment="Center" />
                                            <Button
                                                AutomationProperties.AutomationId="RefreshProcessCatalogButton"
                                                Command="{Binding RefreshProcessCatalogCommand}"
                                                Content="重新整理 Teams" />
                                        </StackPanel>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="只列出可用的 Microsoft Teams 程序。只顯示應用程式名稱、處理程序名稱、PID 與視窗資訊；不會儲存路徑或命令列。"
                                            TextWrapping="Wrap" />
                                        <ListView
                                            AutomationProperties.AutomationId="ProcessCatalogList"
                                            ItemsSource="{Binding ProcessCatalog}"
                                            MaxHeight="180"
                                            SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                                            SelectionMode="Single">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:ProcessSelectionChoice">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ProcessDescription}" />
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind WindowDescription}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind WindowAvailabilityText}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding ProcessCatalogStatusText}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Spacing="5">
                                        <TextBlock Text="工作階段資料庫" />
                                        <TextBox
                                            AutomationProperties.AutomationId="OutputFolderTextBox"
                                            IsEnabled="{Binding IsDeviceSelectionEnabled}"
                                            PlaceholderText="選擇儲存工作階段的資料夾"
                                            Text="{Binding OutputFolder, Mode=TwoWay}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding NextOutputPath}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="20"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="儲存空間與結果" />
                                    <TextBlock Text="{Binding StorageReadinessText}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding ResultText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid
                    x:Name="RecordingsWorkspace"
                    AutomationProperties.AutomationId="RecordingsWorkspace"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="20,16,20,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="RecordingsTitle" Style="{StaticResource TitleTextBlockStyle}" Text="錄音庫" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding LibrarySummaryText}" />
                        </StackPanel>
                        <CommandBar
                            Grid.Column="1"
                            Background="Transparent"
                            ClosedDisplayMode="Compact"
                            DefaultLabelPosition="Collapsed">
                            <AppBarButton
                                x:Uid="RefreshLibraryButton"
                                AutomationProperties.AutomationId="RefreshLibraryButton"
                                Command="{Binding RefreshLibraryCommand}"
                                Icon="Refresh"
                                Label="重新掃描錄音庫" />
                            <AppBarSeparator />
                            <AppBarButton AutomationProperties.AutomationId="PlayRecordingButton" Command="{Binding PlayCommand}" Icon="Play" Label="播放" />
                            <AppBarButton AutomationProperties.AutomationId="PauseRecordingButton" Command="{Binding PauseCommand}" Icon="Pause" Label="暫停" />
                            <AppBarButton AutomationProperties.AutomationId="StopPlaybackButton" Command="{Binding StopPlaybackCommand}" Icon="Stop" Label="停止播放" />
                        </CommandBar>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="1120" Padding="20,0,20,28" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="LibrarySection"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBox
                                        x:Uid="LibrarySearchBox"
                                        AutomationProperties.AutomationId="LibrarySearchBox"
                                        PlaceholderText="搜尋名稱、標籤與逐字稿"
                                        Text="{Binding LibrarySearchText, Mode=TwoWay}"
                                        TextChanged="OnLibrarySearchTextChanged" />
                                    <ToggleSwitch
                                        Grid.Row="1"
                                        x:Uid="LibraryFavoritesOnlyToggle"
                                        AutomationProperties.AutomationId="LibraryFavoritesOnlyToggle"
                                        Header="只顯示最愛"
                                        IsOn="{Binding LibraryFavoritesOnly, Mode=TwoWay}" />
                                    <ListView
                                        Grid.Row="2"
                                        AutomationProperties.AutomationId="RecordingLibraryList"
                                        ItemsSource="{Binding LibraryItems}"
                                        MaxHeight="510"
                                        SelectedItem="{Binding SelectedLibraryItem, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Padding="4,8" Spacing="4">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            AutomationProperties.AutomationId="LibraryRowTitle"
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="{Binding DisplayName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding AvailabilityText}"
                                                            VerticalAlignment="Center" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border Padding="6,2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                                            <TextBlock AutomationProperties.AutomationId="LibraryRowMediaKindChip" Text="{Binding MediaKindText}" />
                                                        </Border>
                                                        <Border Padding="6,2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                                            <TextBlock AutomationProperties.AutomationId="LibraryRowRecoveryChip" Text="{Binding RecoveryChipText}" />
                                                        </Border>
                                                        <Border Padding="6,2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                                            <TextBlock AutomationProperties.AutomationId="LibraryRowAiChip" Text="{Binding AiChipText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock
                                                        AutomationProperties.AutomationId="LibraryRowTags"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding TagsText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        AutomationProperties.AutomationId="LibraryTranscriptSnippetText"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        FontStyle="Italic"
                                                        MaxLines="3"
                                                        Text="{Binding TranscriptSnippet}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <Border
                                x:Name="PlaybackSection"
                                Grid.Column="1"
                                Padding="20"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Uid="PlaybackSectionTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="播放" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="PlaybackSelectedDetails"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding SelectedLibraryDetails}"
                                        TextWrapping="Wrap" />
                                    <Grid Height="260" MinHeight="180">
                                        <MediaPlayerElement
                                            x:Name="PlaybackVideoStage"
                                            AutomationProperties.AutomationId="PlaybackVideoStage"
                                            AreTransportControlsEnabled="False"
                                            AutoPlay="False"
                                            Stretch="Uniform"
                                            Visibility="{Binding IsVideoPlaybackStageVisible}" />
                                        <Border
                                            AutomationProperties.AutomationId="PlaybackAudioStage"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="10"
                                            Visibility="{Binding IsAudioPlaybackStageVisible}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="42" Glyph="&#xE189;" HorizontalAlignment="Center" />
                                                <TextBlock x:Uid="PlaybackAudioStageText" Text="純音訊錄音" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel
                                            AutomationProperties.AutomationId="PlaybackTransportOverlay"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Bottom">
                                            <Button
                                                AutomationProperties.AutomationId="PlaybackSkipBackward15Button"
                                                Command="{Binding SkipBackward15Command}"
                                                Content="−15 秒" />
                                            <Button
                                                AutomationProperties.AutomationId="PlaybackPlayButton"
                                                Command="{Binding PlayCommand}"
                                                Content="播放" />
                                            <Button
                                                AutomationProperties.AutomationId="PlaybackPauseButton"
                                                Command="{Binding PauseCommand}"
                                                Content="暫停" />
                                            <Button
                                                AutomationProperties.AutomationId="PlaybackSkipForward15Button"
                                                Command="{Binding SkipForward15Command}"
                                                Content="+15 秒" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="6">
                                        <TextBlock AutomationProperties.AutomationId="PlaybackStatusText" Text="{Binding PlaybackText}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock AutomationProperties.AutomationId="PlaybackElapsedText" Text="{Binding PlaybackElapsedText}" VerticalAlignment="Center" />
                                            <Slider
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="PlaybackSlider"
                                                IsEnabled="{Binding CanSeek}"
                                                Maximum="{Binding PlaybackDurationSeconds}"
                                                Minimum="0"
                                                Value="{Binding PlaybackPositionSeconds, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" AutomationProperties.AutomationId="PlaybackRemainingText" Text="{Binding PlaybackRemainingText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="PlaybackVolumeLabel" Text="音量" VerticalAlignment="Center" />
                                        <Slider
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="PlaybackVolumeSlider"
                                            Maximum="1"
                                            Minimum="0"
                                            Value="{Binding PlaybackVolume, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" x:Uid="PlaybackRateLabel" Margin="4,0,0,0" Text="速度" VerticalAlignment="Center" />
                                        <ComboBox
                                            Grid.Column="3"
                                            AutomationProperties.AutomationId="PlaybackRateComboBox"
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding PlaybackRateChoices}"
                                            SelectedValue="{Binding SelectedPlaybackRate, Mode=TwoWay}"
                                            SelectedValuePath="Rate" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Padding="6,2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                            <TextBlock AutomationProperties.AutomationId="PlaybackMediaKindChip" Text="{Binding PlaybackMediaKindText}" />
                                        </Border>
                                        <Border Padding="6,2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                            <TextBlock AutomationProperties.AutomationId="PlaybackRecoveryChip" Text="{Binding PlaybackRecoveryText}" />
                                        </Border>
                                        <Border Padding="6,2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                            <TextBlock AutomationProperties.AutomationId="PlaybackAiChip" Text="{Binding PlaybackAiChipText}" />
                                        </Border>
                                        <TextBlock AutomationProperties.AutomationId="PlaybackTimeReadout" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding PlaybackTimeReadout}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            AutomationProperties.AutomationId="LibraryTitleTextBox"
                                            Header="名稱"
                                            IsEnabled="{Binding CanManageLibrary}"
                                            PlaceholderText="為這個工作階段命名"
                                            Text="{Binding LibraryTitle, Mode=TwoWay}" />
                                        <TextBox
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="LibraryTagsTextBox"
                                            Header="標籤"
                                            IsEnabled="{Binding CanManageLibrary}"
                                            PlaceholderText="以逗號分隔，例如：客戶、週會"
                                            Text="{Binding LibraryTagsText, Mode=TwoWay}" />
                                    </Grid>
                                    <ToggleSwitch
                                        AutomationProperties.AutomationId="LibraryFavoriteToggle"
                                        Header="最愛"
                                        IsEnabled="{Binding CanManageLibrary}"
                                        IsOn="{Binding IsLibraryFavorite, Mode=TwoWay}" />
                                    <CommandBar Background="Transparent" ClosedDisplayMode="Compact" DefaultLabelPosition="Right">
                                        <AppBarButton AutomationProperties.AutomationId="SaveLibraryMetadataButton" Command="{Binding SaveLibraryMetadataCommand}" Icon="Save" Label="儲存資料" />
                                        <AppBarButton AutomationProperties.AutomationId="OpenLibraryFolderButton" Command="{Binding OpenLibraryFolderCommand}" Icon="OpenFile" Label="開啟資料夾" />
                                        <AppBarButton AutomationProperties.AutomationId="RequestRecycleLibraryButton" Command="{Binding RequestRecycleLibraryCommand}" Icon="Delete" Label="移至資源回收桶" />
                                        <AppBarButton AutomationProperties.AutomationId="ConfirmRecycleLibraryButton" Command="{Binding ConfirmRecycleLibraryCommand}" Icon="Accept" Label="確認移除" />
                                        <AppBarButton AutomationProperties.AutomationId="CancelRecycleLibraryButton" Command="{Binding CancelRecycleLibraryCommand}" Icon="Cancel" Label="取消" />
                                    </CommandBar>
                                    <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{Binding RecycleConfirmationText}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button
                                            AutomationProperties.AutomationId="StartTranscriptionButton"
                                            Click="OnStartOpenAiTranscriptionClick"
                                            Content="轉錄選取錄音"
                                            IsEnabled="{Binding CanStartOpenAiTranscription}" />
                                        <Button
                                            AutomationProperties.AutomationId="GenerateSummaryButton"
                                            Click="OnGenerateOpenAiSummaryClick"
                                            Content="產生選取摘要"
                                            IsEnabled="{Binding CanGenerateOpenAiSummary}" />
                                    </StackPanel>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="轉錄只會在您確認後上傳所選錄音；摘要只會在您再次確認後傳送該錄音的逐字稿文字。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid
                    x:Name="SettingsWorkspace"
                    AutomationProperties.AutomationId="SettingsWorkspace"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="20,16,20,12" Spacing="2">
                        <TextBlock x:Uid="SettingsTitle" Style="{StaticResource TitleTextBlockStyle}" Text="設定" />
                        <TextBlock x:Uid="SettingsSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Teams、AI 與診斷選項" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="1060" Padding="20,0,20,28" Spacing="16">
                            <Border
                                Padding="20"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Uid="TeamsSettingsTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="Teams 整合" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="啟用後，應用程式只會在本機監看已驗證的 Teams 視窗；不會連線至 Teams Third-party API，也不會使用配對或 WebSocket 權杖。Teams UI 自動化綁定尚未驗證時，靜音同步會安全地維持停用。"
                                        TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding TeamsLocalStatusText}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding TeamsLocalRoutingText}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button AutomationProperties.AutomationId="EnableTeamsMuteSyncButton" Command="{Binding EnableTeamsMuteSyncCommand}" Content="啟用 Teams 本機監看" />
                                        <Button AutomationProperties.AutomationId="DisableTeamsMuteSyncButton" Command="{Binding DisableTeamsMuteSyncCommand}" Content="停用 Teams 本機監看" />
                                    </StackPanel>
                                    <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                        <StackPanel Spacing="8">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Teams 自動錄音（選用）" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="預設關閉。只有在本機 Teams 會議視窗通過程序身分與穩定 UI Automation 證據驗證後，才能由使用者明確啟用；此功能只控制本機工作階段。"
                                                TextWrapping="Wrap" />
                                            <InfoBar
                                                IsClosable="False"
                                                IsOpen="True"
                                                Message="Teams 的「Make a test call」可能不會呈現可驗證的會議介面，因此不會觸發自動錄音。請在真實 Teams 會議中驗證此 Preview；無法確認時會維持停用。"
                                                Severity="Informational"
                                                Title="測試限制" />
                                            <TextBlock Text="{Binding TeamsLocalAutomaticRecordingStatusText}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Button AutomationProperties.AutomationId="EnableTeamsAutomaticRecordingButton" Command="{Binding EnableTeamsAutomaticRecordingCommand}" Content="啟用自動錄音" />
                                                <Button AutomationProperties.AutomationId="DisableTeamsAutomaticRecordingButton" Command="{Binding DisableTeamsAutomaticRecordingCommand}" Content="停用自動錄音" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="20"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Uid="TranscriptionSettingsTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="轉錄與 AI" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="OpenAI 相容 API" />
                                    </StackPanel>
                                    <TextBox AutomationProperties.AutomationId="OpenAiBaseUrlTextBox" Header="API Base URL" IsEnabled="{Binding IsOpenAiProviderAvailable}" Text="{Binding OpenAiApiBaseUrl, Mode=TwoWay}" />
                                    <PasswordBox
                                        x:Name="OpenAiApiKeyPasswordBox"
                                        AutomationProperties.AutomationId="OpenAiApiKeyPasswordBox"
                                        Header="{Binding OpenAiApiKeyFieldLabel}"
                                        IsEnabled="{Binding IsOpenAiProviderAvailable}"
                                        PasswordChar="●"
                                        PlaceholderText="留空會保留已儲存的 API Key" />
                                    <ComboBox AutomationProperties.AutomationId="OpenAiAsrModelComboBox" Header="ASR Model" IsEditable="True" IsEnabled="{Binding IsOpenAiProviderAvailable}" ItemsSource="{Binding OpenAiDiscoveredModels}" Text="{Binding OpenAiAsrModel, Mode=TwoWay}" />
                                    <ComboBox AutomationProperties.AutomationId="OpenAiLlmModelComboBox" Header="LLM Model" IsEditable="True" IsEnabled="{Binding IsOpenAiProviderAvailable}" ItemsSource="{Binding OpenAiDiscoveredModels}" Text="{Binding OpenAiLlmModel, Mode=TwoWay}" />
                                    <TextBox AutomationProperties.AutomationId="OpenAiLanguageTextBox" Header="Language（選填）" IsEnabled="{Binding IsOpenAiProviderAvailable}" PlaceholderText="例如：zh 或 en" Text="{Binding OpenAiLanguage, Mode=TwoWay}" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Prompt（選填）" />
                                        <TextBox
                                            AutomationProperties.AutomationId="OpenAiPromptTextBox"
                                            AcceptsReturn="True"
                                            Height="76"
                                            IsEnabled="{Binding IsOpenAiProviderAvailable}"
                                            PlaceholderText="提供專有名詞或轉錄偏好"
                                            Text="{Binding OpenAiPrompt, Mode=TwoWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button AutomationProperties.AutomationId="SaveOpenAiSettingsButton" Click="OnSaveOpenAiProviderSettingsClick" Content="儲存" IsEnabled="{Binding CanSaveOpenAiProvider}" />
                                        <Button AutomationProperties.AutomationId="TestOpenAiConnectionButton" Command="{Binding TestOpenAiProviderConnectionCommand}" Content="測試連線" />
                                        <Button AutomationProperties.AutomationId="ClearOpenAiApiKeyButton" Click="OnClearOpenAiApiKeyClick" Content="移除 Key" IsEnabled="{Binding CanRemoveOpenAiApiKey}" />
                                        <ProgressRing Height="20" IsActive="{Binding IsTestingOpenAiProvider}" Width="20" />
                                    </StackPanel>
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding OpenAiProviderIntegrationStatus}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="20"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Uid="DiagnosticsSettingsTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="診斷" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button AutomationProperties.AutomationId="SaveDiagnosticsButton" Command="{Binding SaveDiagnosticsCommand}" Content="儲存診斷報告" />
                                        <Button AutomationProperties.AutomationId="OpenDiagnosticsFolderButton" Command="{Binding OpenDiagnosticsFolderCommand}" Content="開啟診斷資料夾" />
                                    </StackPanel>
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding DiagnosticsExportStatusText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Teams 整合仍屬 Preview；靜音狀態更新需要在實際 Teams 租戶／用戶端重複驗證。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
