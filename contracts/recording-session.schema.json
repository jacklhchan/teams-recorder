{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jacklhchan/teams-recorder/contracts/recording-session.schema.json",
  "title": "Local Meeting Recorder session metadata",
  "type": "object",
  "required": [
    "schemaVersion",
    "tags",
    "isFavorite",
    "mediaKind",
    "screenIntervals",
    "recoveryState",
    "source",
    "participants"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "isFavorite": {
      "type": "boolean"
    },
    "mediaKind": {
      "enum": [
        "audio",
        "video"
      ]
    },
    "screenIntervals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "startSeconds",
          "endSeconds"
        ],
        "properties": {
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "capturedTeamsWindow": {
      "type": "object",
      "required": [
        "processID",
        "windowID",
        "title"
      ],
      "properties": {
        "processID": {
          "type": "integer",
          "minimum": 0
        },
        "windowID": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "recoveryState": {
      "enum": [
        "none",
        "videoLostAudioPreserved",
        "recoveredAfterInterruption"
      ]
    },
    "windowsCapture": {
      "type": "object",
      "properties": {
        "audioSource": {
          "enum": [
            "systemLoopback",
            "selectedProcessLoopback"
          ]
        },
        "processName": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^[^<>:\"/\\\\|?*\\u0000-\\u001F]+\\.[eE][xX][eE]$",
          "not": {
            "pattern": "^[.]?[eE][xX][eE]$"
          }
        },
        "includedProcessTree": {
          "type": "boolean"
        },
        "endpointId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "audioSource": {
                "const": "selectedProcessLoopback"
              }
            },
            "required": [
              "audioSource"
            ]
          },
          "then": {
            "required": [
              "processName",
              "includedProcessTree"
            ],
            "properties": {
              "includedProcessTree": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "audioSource": {
                "const": "systemLoopback"
              }
            },
            "required": [
              "audioSource"
            ]
          },
          "then": {
            "required": [
              "includedProcessTree"
            ],
            "properties": {
              "includedProcessTree": {
                "const": false
              }
            },
            "not": {
              "required": [
                "processName"
              ]
            }
          }
        }
      ]
    },
    "source": {
      "enum": [
        "manual",
        "teamsAutomatic",
        "imported"
      ]
    },
    "meetingType": {
      "type": "string",
      "minLength": 1
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
